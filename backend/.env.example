# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Admin (private user onboarding) ---

# Sent as the X-Admin-Key header to POST /admin/users. Keep it out of the frontend.
ADMIN_API_KEY=your-admin-api-key

# --- Postgres (Alembic + direct DB access) ---

# Use the DIRECT connection (host: db.<ref>.supabase.co).
# Do NOT use the transaction pooler URL (pooler.supabase.com) — migrations require a session connection.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- OpenAI (needed once the LLM / embedding layer is wired up) ---

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4o

# --- Retrieval (all optional; defaults shown) ---

# Candidates fetched per retriever (semantic + keyword) before RRF fusion.
RETRIEVAL_CANDIDATE_K=50
# Fused passages surfaced to the LLM after RRF.
RETRIEVAL_TOP_K=5
# RRF smoothing constant (Cormack et al., SIGIR 2009).
RETRIEVAL_RRF_K=60
# Max keyword terms extracted from a query for the full-text search leg.
RETRIEVAL_KEYWORD_MAX_TERMS=5

# --- Agent run guards (all optional; defaults shown) ---

# Max tool calls per answer run; prevents the evidence set from exploding.
AGENT_TOOL_CALLS_LIMIT=16
# Max input tokens accumulated across requests in one run.
AGENT_MAX_INPUT_TOKENS=24000

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173
